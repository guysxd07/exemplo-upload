<!DOCTYPE html>
<html>
<head> <%- include('head'); %> </head>
<body>
 <header> <%- include('menu'); %> </header>
 <div class="container">
 <h2>Editar</h2>
 <% dadosProduto.forEach(function(dados) { %>
 <form action="/editar/<%= dados.id %>" method="POST">
 <div class="form-group"> <label for="usr">Nome:</label>
 <input type="text" class="form-control" name="nome" value="<%= dados.nome %>" required>
 </div>
 <div class="form-group"> <label for="usr">Descricao:</label>
 <input type="textaarea" class="form-control" name="descricao" value="<%= dados.descricao %>"
required>
 </div>
 <button type="submit" class="btn btn-primary">Enviar</button>
 </form>
 <% }) %>
 </div>
 <button><a href="/" class="material-icons " >arrow_back</a></button>
</body>
</html>